import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings("ignore")

# Load data
master_df = pd.read_csv("master_data.csv", index_col="Date", parse_dates=True)

I     = master_df["crsp50_index"]
r     = master_df["crsp50_log_ret"]
r_spy = master_df["spy_log_ret"]
V     = master_df["vix"]

# ── Panel A ──────────────────────────────────────────────────
mom_21         = I / I.shift(21) - 1
mom_63         = I / I.shift(63) - 1
macd_12_26     = I.ewm(halflife=12).mean() - I.ewm(halflife=26).mean()
stochk_14      = (I - I.rolling(14).min()) / (I.rolling(14).max() - I.rolling(14).min() + 1e-10)
delta          = I.diff()
rsi_14         = 100 - 100 / (1 + delta.clip(lower=0).rolling(14).mean() / ((-delta.clip(upper=0)).rolling(14).mean() + 1e-10))

def trend_slope(series, L=63):
    x = np.arange(L); x_bar = x.mean(); denom = ((x - x_bar)**2).sum()
    vals = np.log(series.values)
    out  = np.full(len(vals), np.nan)
    for t in range(L-1, len(vals)):
        y = vals[t-L+1:t+1]
        out[t] = ((x - x_bar) * (y - y.mean())).sum() / denom
    return pd.Series(out, index=series.index)

trend_slope_63 = trend_slope(I)

# ── Panel B ──────────────────────────────────────────────────
dd_63       = 1 - I / I.rolling(63).max()
dd_126      = 1 - I / I.rolling(126).max()
dd_252      = 1 - I / I.rolling(252).max()
rv_21       = r.rolling(21).std()
rv_63       = r.rolling(63).std()
rv_126      = r.rolling(126).std()
downside_63 = np.sqrt(r.clip(upper=0).pow(2).rolling(63).mean())
rvv_63      = rv_21.rolling(63).std()

# ── Panel C ──────────────────────────────────────────────────
vix         = V.copy()
log_vix     = np.log(V)
vix_diff_21 = V - V.shift(21)
vix_ewma_21 = V.ewm(halflife=21).mean()

# ── Panel D ──────────────────────────────────────────────────
ret_mkt       = r_spy.copy()
ret_act       = r - r_spy
ret_crsp_lag1 = r.shift(1)
ret_act_lag1  = ret_act.shift(1)
beta_63       = r.rolling(63).cov(r_spy) / r_spy.rolling(63).var()
act_rv_21     = ret_act.rolling(21).std()

# ── Assemble all 24 features ─────────────────────────────────
features_df = pd.DataFrame({
    "mom_21": mom_21, "mom_63": mom_63, "trend_slope_63": trend_slope_63,
    "macd_12_26": macd_12_26, "stochk_14": stochk_14, "rsi_14": rsi_14,
    "dd_63": dd_63, "dd_126": dd_126, "dd_252": dd_252,
    "rv_21": rv_21, "rv_63": rv_63, "rv_126": rv_126,
    "downside_63": downside_63, "rvv_63": rvv_63,
    "vix": vix, "log_vix": log_vix, "vix_diff_21": vix_diff_21, "vix_ewma_21": vix_ewma_21,
    "ret_mkt": ret_mkt, "ret_act": ret_act,
    "ret_crsp_lag1": ret_crsp_lag1, "ret_act_lag1": ret_act_lag1,
    "beta_63": beta_63, "act_rv_21": act_rv_21,
}).dropna()

print(f"Features shape: {features_df.shape}")
print(features_df.tail(3))

features_df.to_csv("features.csv")
print("Saved: features.csv")

Sparse Jump Model

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import warnings
warnings.filterwarnings("ignore")

# ── Load ──────────────────────────────────────────────────────
master_df   = pd.read_csv("master_data.csv",  index_col="Date", parse_dates=True)
features_df = pd.read_csv("features.csv",     index_col="Date", parse_dates=True)
r           = master_df["crsp50_log_ret"].reindex(features_df.index)
index_lvl   = master_df["crsp50_index"].reindex(features_df.index)

# ── Standardize ───────────────────────────────────────────────
def standardize(X):
    med = X.median()
    mad = (X - med).abs().median().replace(0, 1)
    return (X - med) / mad

# ── DP (vectorized) ───────────────────────────────────────────
def dp_labels(X, t0, t1, w, lam):
    # X: (T,p), t0/t1: (p,), w: (p,)
    c = lambda t, k: 0.5 * ((X - (t0 if k==0 else t1))**2 @ w)
    c0, c1 = c(None, 0), c(None, 1)
    T = len(X)
    cost = np.zeros((T, 2))
    back = np.zeros((T, 2), dtype=int)
    cost[0] = [c0[0], c1[0]]
    for t in range(1, T):
        for k in range(2):
            ck = c0[t] if k==0 else c1[t]
            if cost[t-1,k] <= cost[t-1,1-k] + lam:
                cost[t,k] = cost[t-1,k]   + ck; back[t,k] = k
            else:
                cost[t,k] = cost[t-1,1-k] + ck + lam; back[t,k] = 1-k
    z = np.zeros(T, dtype=int)
    z[-1] = np.argmin(cost[-1])
    for t in range(T-2, -1, -1):
        z[t] = back[t+1, z[t+1]]
    return z

# ── Fit SJM ───────────────────────────────────────────────────
def fit_sjm(X, lam, kap, n_iter=15):
    z = (X[:,0] > np.median(X[:,0])).astype(int)
    w = np.ones(X.shape[1]) / X.shape[1]
    for _ in range(n_iter):
        t0 = X[z==0].mean(0) if (z==0).any() else X.mean(0)
        t1 = X[z==1].mean(0) if (z==1).any() else X.mean(0)
        d2 = (t1 - t0)**2
        w  = d2 / d2.sum() * kap if d2.sum() > 1e-10 else np.ones(len(d2))/len(d2)*kap
        z  = dp_labels(X, t0, t1, w, lam)
    return z, t0, t1, w

# ── Grid search params ────────────────────────────────────────
LAM   = [10, 20, 40, 80, 160, 320]
KAP   = [0.5, 1, 2, 4, 6]

# ── Annual expanding estimation ───────────────────────────────
year_ends = features_df.index[
    (features_df.index.month == 9) & (features_df.index.day >= 28)
]
all_regimes = pd.Series(np.nan, index=features_df.index)

for i, eval_end in enumerate(year_ends):
    seg_start = pd.Timestamp("2018-09-30") if i == 0 else year_ends[i-1] + pd.Timedelta(days=1)
    if seg_start > eval_end or seg_start < pd.Timestamp("2018-09-30"):
        continue

    # training data
    X_tr = standardize(features_df[features_df.index < seg_start])
    r_tr = r[r.index < seg_start]

    # top-24 features by correlation with next-day return
    r_next = r.shift(-1).reindex(X_tr.index).dropna()
    X_corr = X_tr.reindex(r_next.index)
    top24  = X_corr.corrwith(r_next).abs().nlargest(24).index.tolist()
    X_tr   = X_tr[top24]

    # 80/20 inner split
    n  = len(X_tr)
    Xi = X_tr.iloc[:int(0.8*n)].values
    Xv = X_tr.iloc[int(0.8*n):].values
    rv = r_tr.iloc[int(0.8*n):]

    # grid search
    best, bl, bk = -999, 80, 0.5
    for lam in LAM:
        for kap in KAP:
            _, t0, t1, w = fit_sjm(Xi, lam, kap)
            zv   = dp_labels(Xv, t0, t1, w, lam)
            bc   = rv.values * zv
            nsw  = (np.diff(zv)!=0).sum() / (len(zv)/252)
            sr   = bc.mean()/bc.std()*np.sqrt(252) - 0.5*nsw if bc.std()>1e-10 else -999
            if sr > best:
                best, bl, bk = sr, lam, kap

    # refit on full training window
    _, t0, t1, w = fit_sjm(X_tr.values, bl, bk)

    # apply to eval segment
    emask = (features_df.index >= seg_start) & (features_df.index <= eval_end)
    Xe    = standardize(features_df[top24])[emask].values
    ze    = dp_labels(Xe, t0, t1, w, bl)
    all_regimes[features_df.index[emask]] = ze

    print(f"{seg_start.date()} → {eval_end.date()} | λ={bl} κ={bk} | bull={ze.sum()} bear={(ze==0).sum()}")

# ── Trim & save ───────────────────────────────────────────────
regimes = all_regimes["2018-09-30":"2025-09-30"].dropna().astype(int)
regimes.to_csv("regimes.csv", header=["regime"])

# ── Stats ─────────────────────────────────────────────────────
r_eval = r.reindex(regimes.index)
for name, ret in [("hold", r_eval), ("bull-cash", r_eval * regimes)]:
    s = ret.dropna()
    ar = s.mean()*252; av = s.std()*np.sqrt(252)
    print(f"{name:12s}  ret={ar*100:.2f}%  vol={av*100:.2f}%  sharpe={ar/av:.3f}")

print("\nPaper: hold ret=14.32% vol=19.41% sharpe=0.750")
print("Paper: bull-cash ret=14.73% vol=11.65% sharpe=1.240")

# ── Plot ──────────────────────────────────────────────────────
r_eval  = r.reindex(regimes.index)
cum_h   = (index_lvl.reindex(regimes.index) / index_lvl.reindex(regimes.index).iloc[0] - 1) * 100
cum_bc  = ((1 + r_eval * regimes).cumprod() - 1) * 100

fig, ax = plt.subplots(figsize=(14, 5))
ax.plot(cum_h.index,  cum_h,  color="#1f4e79", lw=1.5, label="Hold")
ax.plot(cum_bc.index, cum_bc, color="#e8820c", lw=1.5, label="Bull-Cash")
prev = None
for d, reg in regimes.items():
    if prev is not None:
        ax.axvspan(prev, d, alpha=0.12, color="green" if reg==1 else "red", lw=0)
    prev = d
ax.set_title("Regimes: green=bull  red=bear", fontweight="bold")
ax.legend(); ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig("regimes.png", dpi=150, bbox_inches="tight")
plt.show()
print("Saved: regimes.csv  regimes.png")

Universal Portfolio
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import warnings
warnings.filterwarnings("ignore")

# ── Load ──────────────────────────────────────────────────────
master_df     = pd.read_csv("master_data.csv",      index_col="Date", parse_dates=True)
stock_ret     = pd.read_csv("stock_returns.csv",     index_col="Date", parse_dates=True)
init_weights  = pd.read_csv("initial_weights.csv",   index_col=0, header=0)
regimes       = pd.read_csv("regimes.csv",           index_col="Date", parse_dates=True)["regime"]

EVAL_START = "2018-09-30"
EVAL_END   = "2025-09-30"

# align everything to eval window
regimes   = regimes[EVAL_START:EVAL_END]
stock_ret = stock_ret.reindex(regimes.index).fillna(0)
r_index   = master_df["crsp50_log_ret"].reindex(regimes.index)
index_lvl = master_df["crsp50_index"].reindex(regimes.index)

m = stock_ret.shape[1]   # number of stocks (48)

# ── Sample 4096 Dirichlet portfolios ─────────────────────────
np.random.seed(42)
K       = 4096
alphas  = [0.1, 0.3, 1.0, 3.0]
weights = [0.20, 0.30, 0.30, 0.20]
n_each  = [int(w * K) for w in weights]
n_each[-1] = K - sum(n_each[:-1])   # make sure it sums to K

particles = np.vstack([
    np.random.dirichlet(np.ones(m) * a, size=n)
    for a, n in zip(alphas, n_each)
])  # shape: (K, m)

# ── Helper: annualized stats ──────────────────────────────────
def stats(ret_series, name):
    s  = ret_series.dropna()
    ar = s.mean() * 252
    av = s.std()  * np.sqrt(252)
    sr = ar / av
    cum = (1 + s).cumprod()
    md  = ((cum - cum.cummax()) / cum.cummax()).min()
    print(f"  {name:30s}  ret={ar*100:.2f}%  vol={av*100:.2f}%  sharpe={sr:.4f}  maxdd={md*100:.2f}%")
    return dict(ret=ar, vol=av, sharpe=sr, maxdd=md)

# ── Hindsight best CRP (regime-blind) ────────────────────────
# solve: max sum_t log(b @ x_t)  via exponentiated gradient
def best_crp(stock_ret_df, n_iter=500, eta0=0.5):
    X  = (1 + stock_ret_df.values).clip(1e-10)   # gross returns (T, m)
    b  = np.ones(m) / m
    for i in range(n_iter):
        eta = eta0 / np.sqrt(i + 1)
        g   = X / (X @ b).reshape(-1, 1) 
        g   = g.mean(0)
        b   = b * np.exp(eta * g)
        b  /= b.sum()
    return b

print("Computing hindsight best CRP (regime-blind)...")
b_blind = best_crp(stock_ret.loc[regimes.index])
crp_blind_ret = (stock_ret.loc[regimes.index] @ b_blind)  # daily simple returns

# ── Hindsight best CRP (regime-aware) ────────────────────────
# optimize only over bull days
bull_days = regimes[regimes == 1].index
print("Computing hindsight best CRP (regime-aware)...")
b_aware = best_crp(stock_ret.loc[bull_days])

# apply: bull days use b_aware, bear days = 0 return
crp_aware_ret = pd.Series(0.0, index=regimes.index)
crp_aware_ret[bull_days] = stock_ret.loc[bull_days] @ b_aware

# ── Universal Portfolio (regime-blind) ───────────────────────
print("Running regime-blind universal portfolio...")
particle_wealth = np.ones(K)           # equal prior weights
up_blind_rets   = []

X_all = (1 + stock_ret.loc[regimes.index].values).clip(1e-10)  # (T, m)

for t in range(len(regimes)):
    x_t = X_all[t]                                # gross returns today

    # portfolio = wealth-weighted average of particles
    pi   = particle_wealth / particle_wealth.sum()
    b_t  = pi @ particles                         # (m,)

    # daily return
    ret_t = b_t @ (x_t - 1)
    up_blind_rets.append(ret_t)

    # update particle wealth
    particle_wealth *= (particles @ x_t)

up_blind_ret = pd.Series(up_blind_rets, index=regimes.index)

# ── Universal Portfolio (regime-aware) ───────────────────────
print("Running regime-aware universal portfolio...")
particle_wealth = np.ones(K)
up_aware_rets   = []

for t, (date, regime) in enumerate(regimes.items()):
    x_t = X_all[t]

    if regime == 0:
        # bear: hold cash, freeze particles
        up_aware_rets.append(0.0)
    else:
        # bull: normal UP update
        pi   = particle_wealth / particle_wealth.sum()
        b_t  = pi @ particles
        ret_t = b_t @ (x_t - 1)
        up_aware_rets.append(ret_t)
        particle_wealth *= (particles @ x_t)

up_aware_ret = pd.Series(up_aware_rets, index=regimes.index)

# ── CRSP-50 index (hold) and bull-cash overlay ───────────────
hold_ret     = r_index.reindex(regimes.index)
bullcash_ret = hold_ret * regimes

# ── Performance table ─────────────────────────────────────────
print("\n" + "="*75)
print(f"  {'Strategy':30s}  {'ret':>8}  {'vol':>8}  {'sharpe':>8}  {'maxdd':>8}")
print("="*75)
results = {}
for name, ret in [
    ("crsp50_index",          hold_ret),
    ("crsp50_bull_cash",      bullcash_ret),
    ("up_regime_blind",       up_blind_ret),
    ("best_crp_regime_blind", crp_blind_ret),
    ("up_regime_aware",       up_aware_ret),
    ("best_crp_regime_aware", crp_aware_ret),
]:
    results[name] = stats(ret, name)

print("\nPaper Table 3:")
print("  best_crp_regime_aware          ret=14.17%  vol=11.19%  sharpe=1.2402  maxdd=-13.74%")
print("  best_crp_regime_blind          ret=12.91%  vol=18.57%  sharpe=0.7472  maxdd=-34.77%")
print("  crsp100_bull_cash              ret=14.73%  vol=11.65%  sharpe=1.2381  maxdd=-14.76%")
print("  crsp100_index                  ret=14.32%  vol=19.41%  sharpe=0.7870  maxdd=-30.89%")
print("  up_regime_aware                ret=13.63%  vol=11.16%  sharpe=1.2014  maxdd=-13.65%")
print("  up_regime_blind                ret=12.43%  vol=18.48%  sharpe=0.7268  maxdd=-34.69%")

# ── Cumulative wealth plot (Figure 2) ─────────────────────────
fig, ax = plt.subplots(figsize=(14, 6))

strategies = {
    "CRSP-50 Index":          hold_ret,
    "Bull-Cash Overlay":      bullcash_ret,
    "UP Regime-Blind":        up_blind_ret,
    "Best CRP Regime-Blind":  crp_blind_ret,
    "UP Regime-Aware":        up_aware_ret,
    "Best CRP Regime-Aware":  crp_aware_ret,
}
colors = ["#1f4e79","#e8820c","#70ad47","#ffc000","#c00000","#7030a0"]

for (name, ret), color in zip(strategies.items(), colors):
    cum = (1 + ret.fillna(0)).cumprod()
    ax.plot(cum.index, cum, label=name, color=color, lw=1.5)

ax.set_title("Cumulative Wealth — Universal Portfolio Variants", fontweight="bold")
ax.set_ylabel("Cumulative Wealth")
ax.legend(fontsize=9, loc="upper left")
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig("cumulative_wealth.png", dpi=150, bbox_inches="tight")
plt.show()

print("\nSaved: cumulative_wealth.png")
print("Module 3 complete.")

