import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import warnings
warnings.filterwarnings("ignore")


from arch import arch_model

# ── Load ──────────────────────────────────────────────────────
master_df  = pd.read_csv("master_data.csv",   index_col="Date", parse_dates=True)
stock_ret  = pd.read_csv("stock_returns.csv", index_col="Date", parse_dates=True)
features_df= pd.read_csv("features.csv",      index_col="Date", parse_dates=True)

r         = master_df["crsp50_log_ret"].reindex(features_df.index)
index_lvl = master_df["crsp50_index"].reindex(features_df.index)

EVAL_START = "2018-09-30"
EVAL_END   = "2025-09-30"

# ── RS-GARCH: fit GARCH(1,1) on rolling window ───────────────
# Regime switching GARCH identifies regimes by comparing
# conditional volatility to a threshold:
#   - low vol  → bull regime
#   - high vol → bear regime
#
# We use an annual expanding window (same as SJM/HMM):
# fit GARCH on training data, extract conditional vol,
# then threshold on median vol to assign regimes.

year_ends = features_df.index[
    (features_df.index.month == 9) & (features_df.index.day >= 28)
]
all_regimes = pd.Series(np.nan, index=features_df.index)

for i, eval_end in enumerate(year_ends):
    seg_start = pd.Timestamp(EVAL_START) if i == 0 else year_ends[i-1] + pd.Timedelta(days=1)
    if seg_start > eval_end or seg_start < pd.Timestamp(EVAL_START):
        continue

    # training data
    r_tr = r[r.index < seg_start].dropna() * 100   # scale to % for GARCH

    if len(r_tr) < 200:
        continue

    # fit GARCH(1,1) on training data
    try:
        garch = arch_model(r_tr, vol="Garch", p=1, q=1, dist="normal")
        res   = garch.fit(disp="off", show_warning=False)

        # get conditional vol threshold from training window
        cond_vol_train = res.conditional_volatility
        vol_threshold  = np.median(cond_vol_train)

        # apply to eval segment using rolling 1-step-ahead forecast
        emask  = (r.index >= seg_start) & (r.index <= eval_end)
        r_eval = r[emask].dropna() * 100

        if len(r_eval) == 0:
            continue

        # refit on expanding window up to each eval day (causal)
        # for speed: fit once on training, then use fixed params
        # to forecast vol over eval period
        omega = res.params["omega"]
        alpha = res.params["alpha[1]"]
        beta  = res.params["beta[1]"]

        # initialise with last training vol
        h = cond_vol_train.iloc[-1] ** 2
        labels = []
        for rt in r_eval.values:
            h = omega + alpha * rt**2 + beta * h
            vol_t = np.sqrt(h)
            labels.append(1 if vol_t < vol_threshold else 0)

        labels = np.array(labels)
        all_regimes[r.index[emask][:len(labels)]] = labels

        print(f"{seg_start.date()} → {eval_end.date()} | vol_thresh={vol_threshold:.3f} | bull={labels.sum()} bear={(labels==0).sum()}")

    except Exception as e:
        print(f"{seg_start.date()} → {eval_end.date()} | FAILED: {e}")

# ── Trim to eval window ───────────────────────────────────────
regimes_garch = all_regimes[EVAL_START:EVAL_END].dropna().astype(int)
print(f"\nRS-GARCH regimes: {len(regimes_garch)} days | bull={regimes_garch.sum()} bear={(regimes_garch==0).sum()}")

# ── Run same UP logic ─────────────────────────────────────────
stock_ret_eval = stock_ret.reindex(regimes_garch.index).fillna(0)
r_eval         = r.reindex(regimes_garch.index)
m              = stock_ret_eval.shape[1]
X_all          = (1 + stock_ret_eval.values).clip(1e-10)

# particles
np.random.seed(42)
K      = 4096
alphas = [0.1, 0.3, 1.0, 3.0]
n_each = [int(w * K) for w in [0.20, 0.30, 0.30, 0.20]]
n_each[-1] = K - sum(n_each[:-1])
particles = np.vstack([
    np.random.dirichlet(np.ones(m) * a, size=n)
    for a, n in zip(alphas, n_each)
])

# hindsight best CRP (regime-aware)
def best_crp(X, n_iter=500, eta0=0.5):
    b = np.ones(X.shape[1]) / X.shape[1]
    for i in range(n_iter):
        eta = eta0 / np.sqrt(i+1)
        g   = (X / (X @ b).reshape(-1,1)).mean(0)
        b   = b * np.exp(eta * g); b /= b.sum()
    return b

bull_days = regimes_garch[regimes_garch == 1].index
b_aware   = best_crp((1 + stock_ret_eval.loc[bull_days].values).clip(1e-10))
crp_aware = pd.Series(0.0, index=regimes_garch.index)
crp_aware[bull_days] = stock_ret_eval.loc[bull_days] @ b_aware

# UP regime-aware
particle_wealth = np.ones(K)
up_aware_rets   = []
for t, (date, regime) in enumerate(regimes_garch.items()):
    if regime == 0:
        up_aware_rets.append(0.0)
    else:
        pi  = particle_wealth / particle_wealth.sum()
        b_t = pi @ particles
        up_aware_rets.append(b_t @ (X_all[t] - 1))
        particle_wealth *= (particles @ X_all[t])
up_aware = pd.Series(up_aware_rets, index=regimes_garch.index)

# ── Stats ─────────────────────────────────────────────────────
def stats(ret, name):
    s  = ret.fillna(0)
    ar = s.mean() * 252
    av = s.std()  * np.sqrt(252)
    sr = ar / av
    cum = (1 + s).cumprod()
    md  = ((cum - cum.cummax()) / cum.cummax()).min()
    print(f"  {name:40s}  ret={ar*100:.2f}%  vol={av*100:.2f}%  sharpe={sr:.4f}  maxdd={md*100:.2f}%")

