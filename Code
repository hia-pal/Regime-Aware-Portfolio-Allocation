    (features_df.index.month == 9) & (features_df.index.day >= 28)
]
all_regimes = pd.Series(np.nan, index=features_df.index)

# Use only log return + VIX as HMM input (simple 2-feature HMM)
hmm_input = pd.DataFrame({
    "log_ret": r,
    "log_vix": np.log(master_df["vix"].reindex(features_df.index))
}).dropna()

for i, eval_end in enumerate(year_ends):
    seg_start = pd.Timestamp(EVAL_START) if i == 0 else year_ends[i-1] + pd.Timedelta(days=1)
    if seg_start > eval_end or seg_start < pd.Timestamp(EVAL_START):
        continue

    # training data
    X_tr = hmm_input[hmm_input.index < seg_start].values

    if len(X_tr) < 100:
        continue

    # fit 2-state Gaussian HMM
    model = GaussianHMM(n_components=2, covariance_type="full",
                        n_iter=100, random_state=42)
    model.fit(X_tr)

    # identify bull state = higher mean return
    means     = model.means_[:, 0]       # mean log return per state
